# =============================================================================
#  service-avis-recommandations — variables d'environnement (EXEMPLE)
# =============================================================================
#  Copier en .env et renseigner les valeurs locales :  cp .env.example .env
#  ⚠️  AUCUN SECRET RÉEL NE DOIT FIGURER DANS CE FICHIER NI ÊTRE COMMITTÉ.
#  En production Swarm, les mots de passe passent par des Docker secrets.
# =============================================================================

NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# --- MongoDB (Mongoose) ---
# Format : mongodb://USER:PASSWORD@HOST:PORT/DATABASE?authSource=admin
MONGODB_URI=mongodb://smartshop:CHANGE_ME@localhost:27017/smartshop_avis?authSource=admin

# --- Flux 1 : appel sortant vers le service Catalogue & Commandes ---
# En Swarm, remplacer localhost par le nom de service : http://catalogue-api:3000
CATALOGUE_SERVICE_URL=http://localhost:3000
CATALOGUE_SERVICE_TIMEOUT_MS=800

# --- GraphQL ---
# Introspection laissée active : utile au correcteur via Apollo Sandbox.
GRAPHQL_INTROSPECTION=true

# --- CORS ---
# Origines autorisées, séparées par des virgules. « * » ouvre à tous :
# acceptable en développement, à restreindre dès qu'une interface web
# réelle consomme l'API.
CORS_ORIGINS=*

# --- Historique de navigation ---
# Les événements sont purgés automatiquement par un index TTL MongoDB.
BROWSING_HISTORY_TTL_DAYS=90

# --- Recommandations : pondérations du score (somme conseillée = 1) ---
# Poids de la note moyenne du produit.
RECO_WEIGHT_RATING=0.5
# Poids de l'affinité avec les catégories consultées par le client.
RECO_WEIGHT_CATEGORY=0.3
# Poids de la co-consultation (clients aux parcours semblables).
RECO_WEIGHT_SIMILAR=0.2
# Nombre minimal d'avis pour qu'un produit noté soit candidat.
RECO_MIN_REVIEWS=1
# Nombre de recommandations renvoyées par défaut.
RECO_DEFAULT_LIMIT=10

# --- Résilience au démarrage (depends_on n'existe pas en Swarm) ---
DB_CONNECT_MAX_RETRIES=5
DB_CONNECT_BASE_DELAY_MS=1000
