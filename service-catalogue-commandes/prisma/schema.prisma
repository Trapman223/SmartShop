// =============================================================================
//  Smart-Shop — service-catalogue-commandes
//  Schéma Prisma — PostgreSQL
// =============================================================================

generator client {
  provider      = "prisma-client-js"
  // linux-musl-openssl-3.0.x est requis pour l'image node:22-alpine.
  // Sans ce binaryTarget, le query engine Prisma ne démarre pas dans le
  // conteneur — cf. CLAUDE.md section 9.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Produit du catalogue.
model Product {
  id          String   @id @default(uuid()) @db.Uuid
  reference   String   @unique @db.VarChar(32)
  name        String   @db.VarChar(200)
  description String?  @db.Text
  price       Decimal  @db.Decimal(10, 2)
  stock       Int
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  orderItems OrderItem[]

  @@index([name])
  @@index([createdAt(sort: Desc)])
  @@map("products")
}

/// Commande client.
model Order {
  id           String      @id @default(uuid()) @db.Uuid
  customerName String      @map("customer_name") @db.VarChar(200)
  status       OrderStatus @default(PENDING)
  total        Decimal     @db.Decimal(12, 2)
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  items OrderItem[]

  @@index([status])
  @@index([customerName])
  @@index([createdAt(sort: Desc)])
  @@map("orders")
}

/// Ligne de commande. `unitPrice` fige le prix du produit au moment de l'achat :
/// une évolution tarifaire ultérieure ne doit pas réécrire l'historique.
model OrderItem {
  id        String  @id @default(uuid()) @db.Uuid
  orderId   String  @map("order_id") @db.Uuid
  productId String  @map("product_id") @db.Uuid
  quantity  Int
  unitPrice Decimal @map("unit_price") @db.Decimal(10, 2)

  // Cascade : supprimer une commande supprime ses lignes.
  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  // Restrict : un produit référencé par une commande ne peut pas être supprimé.
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([orderId, productId])
  @@index([productId])
  @@map("order_items")
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  CANCELLED
}
