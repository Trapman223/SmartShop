# =============================================================================
#  service-catalogue-commandes — variables d'environnement (EXEMPLE)
# =============================================================================
#  Copier en .env et renseigner les valeurs locales :  cp .env.example .env
#  ⚠️  AUCUN SECRET RÉEL NE DOIT FIGURER DANS CE FICHIER NI ÊTRE COMMITTÉ.
#  En production Swarm, les mots de passe passent par des Docker secrets.
# =============================================================================

NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# --- PostgreSQL (Prisma) ---
# Format : postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://smartshop:CHANGE_ME@localhost:5432/smartshop_catalogue?schema=public

# --- Flux 2 : appel sortant vers le service Avis & Recommandations ---
# En Swarm, remplacer localhost par le nom de service : http://avis-api:4000/graphql
AVIS_SERVICE_URL=http://localhost:4000/graphql
AVIS_SERVICE_TIMEOUT_MS=800

# --- Résilience au démarrage (depends_on n'existe pas en Swarm) ---
DB_CONNECT_MAX_RETRIES=5
DB_CONNECT_BASE_DELAY_MS=1000
